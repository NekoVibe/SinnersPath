# Auto detect text files and normalize line endings to LF
* text=auto

# Unity files
*.cs text eol=lf
*.shader text eol=lf
*.asset text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.prefab text eol=lf
*.terrainlayer text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.fbx binary
*.blend binary
*.unitypackage binary
